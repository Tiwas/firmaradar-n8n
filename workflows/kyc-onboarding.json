      "name": "Hent eierskap",
      "type": "n8n-nodes-firmaradar.firmaradarCompany",
      "typeVersion": 1,
      "position": [
        680,
        420
      ],
      "id": "1a000001-0001-4000-8000-000000000005",
      "credentials": {
        "firmaradarApi": {
          "id": "firmaradar-api",
