    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex",
        "options": {}
      },
      "name": "Samle resultater",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        920,
        300
      ],
      "id": "1a000001-0001-4000-8000-000000000006"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $('Risikoscore').item.json.level }}",
              "rightValue": "=hoy",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $('Risikoscore').item.json.level }}",
              "rightValue": "=kritisk",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "name": "Risiko = høy eller kritisk?",
