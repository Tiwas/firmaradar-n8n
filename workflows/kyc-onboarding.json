      "typeVersion": 2.2,
      "position": [
        1140,
        300
      ],
      "id": "1a000001-0001-4000-8000-000000000007"
    },
    {
      "parameters": {
        "channel": "#kyc-alerts",
        "text": "=:rotating_light: *KYC-onboarding-varsel* — risiko: {{ $('Risikoscore').item.json.level }}\nOrgnr: `{{ $('Pakk ut orgnr').item.json.orgnr }}`\nScore: {{ $('Risikoscore').item.json.score }}/100\nAML-treff: {{ $('AML/PEP-screening').item.json.hit_count || 0 }}\nÅpne i Firmaradar: https://firmaradar.no/orgnr/{{ $('Pakk ut orgnr').item.json.orgnr }}",
        "otherOptions": {}
      },
      "name": "Slack — compliance-kanal",
