    {
      "parameters": {
        "jsCode": "// Flat ut konsern-treet til ett item per selskap.\n// Inngang: Ownership-respons fra Firmaradar — Selskap.\n// Utgang: én rad per node i hierarkiet, klar for SplitInBatches.\nconst out = [];\n\nfunction walk(node, depth) {\n  if (!node || typeof node !== 'object') return;\n  out.push({\n    json: {\n      depth,\n      orgnr: node.orgnr,\n      navn: node.navn || node.name,\n      andel: node.andel ?? null,\n    },\n  });\n  const children = node.children || node.barn || [];\n  if (Array.isArray(children)) {\n    for (const child of children) walk(child, depth + 1);\n  }\n}\n\nfor (const item of items) {\n  const payload = item.json;\n  const root = payload.root || payload.down || payload;\n  walk(root, 0);\n}\n\nreturn out;"
      },
      "name": "Flat ut hierarki",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
