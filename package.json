{
  "name": "n8n-nodes-firmaradar",
  "version": "0.4.0",
  "description": "n8n community node for Firmaradar — slå opp norske selskaper, eierstrukturer, konsern, roller, regnskap og AML i arbeidsflytene dine.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "firmaradar",
    "norway",
    "norsk",
    "brreg",
    "company-data",
    "ownership",
    "kyc",
    "aml",
    "due-diligence"
  ],
  "license": "Apache-2.0",
  "homepage": "https://tiwas.github.io/firmaradar-n8n/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiwas/firmaradar-n8n.git"
  },
  "bugs": {
    "url": "https://github.com/Tiwas/firmaradar-n8n/issues"
  },
  "author": {
    "name": "Firmaradar AS",
    "email": "lars@firmaradar.no",
    "url": "https://firmaradar.no"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=8"
  },
  "pnpm": {
    "overrides": {
      "form-data@>=4.0.0 <4.0.4": "^4.0.4"
    }
  },
  "scripts": {
    "build": "tsc && gulp build:icons && node -e \"require('fs').rmSync('dist/tsconfig.tsbuildinfo', { force: true })\"",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FirmaradarApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Firmaradar/FirmaradarCompany.node.js",
      "dist/nodes/Firmaradar/FirmaradarPerson.node.js",
      "dist/nodes/Firmaradar/FirmaradarKyc.node.js",
      "dist/nodes/Firmaradar/FirmaradarBransje.node.js",
      "dist/nodes/Firmaradar/FirmaradarOffentlig.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.84.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0 <2.0"
  }
}
